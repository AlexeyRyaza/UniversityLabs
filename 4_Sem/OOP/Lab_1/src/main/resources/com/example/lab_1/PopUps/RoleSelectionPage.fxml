<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" style="-fx-padding: 20; -fx-alignment: center; -fx-background-color: #f4f4f4;" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lab_1.controller.RoleSelectionController">

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" stylesheets="@../styles.css" text="Выберите роль" />

    <VBox spacing="10" stylesheets="@../styles.css">
        <Button fx:id="clientButton" styleClass="role-button" stylesheets="@../styles.css" text="Клиент" />
        <Button fx:id="operatorButton" styleClass="role-button" stylesheets="@../styles.css" text="Оператор" />
        <Button fx:id="managerButton" styleClass="role-button" stylesheets="@../styles.css" text="Менеджер" />
        <Button fx:id="specialistButton" styleClass="role-button" stylesheets="@../styles.css" text="Специалист предприятия" />
        <Button fx:id="adminButton" styleClass="role-button" stylesheets="@../styles.css" text="Администратор" />
    </VBox>

    <Button fx:id="confirmButton" styleClass="confirm-button" stylesheets="@../styles.css" text="Подтвердить" />
</VBox>
