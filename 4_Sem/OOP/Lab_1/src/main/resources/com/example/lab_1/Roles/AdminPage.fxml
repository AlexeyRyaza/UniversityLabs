<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="500.0" prefWidth="600.0"
            stylesheets="@../styles.css"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.lab_1.controller.Roles.AdminPageController">

   <children>
      <!-- Заголовок -->
      <Label fx:id="L_Title" alignment="CENTER"
             layoutX="200.0" layoutY="10.0"
             prefHeight="50.0" prefWidth="200.0"
             style="-fx-font-weight: bold; -fx-font-size: 20px;"
             text="Администратор"/>

      <!-- Список логов -->
      <ScrollPane fx:id="SP_Logs" fitToWidth="true"
                  layoutX="20.0" layoutY="60.0" prefHeight="350.0" prefWidth="560.0">
         <content>
            <VBox fx:id="VB_Logs" prefHeight="350.0" prefWidth="560.0"
                  style="-fx-padding: 10; -fx-spacing: 10;"/>
         </content>
      </ScrollPane>

      <!-- Кнопки управления -->
      <Button layoutX="20.0" layoutY="430.0"
              onAction="#onRollbackLastAction"
              prefHeight="40.0" prefWidth="260.0"
              styleClass="admin-button"
              text="Откатить последнее действие"/>

      <Button layoutX="320.0" layoutY="430.0"
              onAction="#onBackButtonClicked"
              prefHeight="40.0" prefWidth="260.0"
              styleClass="admin-button"
              text="Назад"/>
   </children>
</AnchorPane>
