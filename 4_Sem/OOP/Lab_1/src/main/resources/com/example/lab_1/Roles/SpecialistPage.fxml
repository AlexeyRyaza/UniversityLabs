<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="473.0" prefWidth="336.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.lab_1.controller.Roles.SideSpecialistPageController">

    <children>
        <Label fx:id="L_Title" alignment="CENTER"
               layoutX="67.0" prefHeight="50.0" prefWidth="226.0"
               style="-fx-font-weight: bold; -fx-font-size: 20px;"
               text="Зарплатные операции"/>

        <!-- Создание зарплатного проекта -->
        <Label layoutX="10.0" layoutY="60.0" style="-fx-font-weight: bold;" text="Создать зарплатный проект"/>
        <Button fx:id="btnCreateProject"
                layoutX="10.0" layoutY="87.0"
                onAction="#onCreateSalaryProject"
                prefHeight="30.0" prefWidth="316.0"
                styleClass="role-button"
                stylesheets="@../styles.css"
                text="Создать Заявку"/>

        <!-- Выплата зарплаты -->
        <Label layoutX="10.0" layoutY="160.0" style="-fx-font-weight: bold;" text="Выплата зарплаты"/>
        <TextField fx:id="TF_Recipient" layoutX="10.0" layoutY="180.0" prefWidth="316.0" promptText="ID получателя"/>
        <TextField fx:id="TF_TransferAmount" layoutX="10.0" layoutY="210.0" prefWidth="316.0" promptText="Сумма"/>
        <Button layoutX="10.0" layoutY="240.0"
                onAction="#onTransfer"
                prefHeight="30.0" prefWidth="316.0"
                styleClass="role-button"
                stylesheets="@../styles.css"
                text="Перевести"/>

        <Button layoutX="10.0" layoutY="290.0"
                onAction="#onPayAll"
                prefHeight="30.0" prefWidth="316.0"
                styleClass="role-button"
                stylesheets="@../styles.css"
                text="Выплатить всем сотрудникам"/>

        <Button layoutX="10.0" layoutY="340.0"
                onAction="#onAddEmployee"
                prefHeight="30.0" prefWidth="316.0"
                styleClass="role-button"
                stylesheets="@../styles.css"
                text="Добавить сотрудника в компанию"/>

        <Button layoutX="14.0" layoutY="400.0"
                mnemonicParsing="false" onAction="#onBackButtonClicked"
                prefHeight="39.0" prefWidth="106.0"
                styleClass="role-button"
                stylesheets="@../styles.css"
                text="Назад"/>
    </children>
</AnchorPane>
