<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" style="-fx-padding: 20; -fx-alignment: center; -fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lab_1.controller.Account.AccountActionController">
    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Choose an action" />
   <HBox prefHeight="17.0" prefWidth="200.0">
      <children>
         <TextField fx:id="TF_Destination" prefHeight="39.0" prefWidth="149.0" promptText="Account id" />
         <TextField fx:id="TF_Amount" prefHeight="41.0" prefWidth="100.0" promptText="Amount" />
      </children>
   </HBox>
    <Button fx:id="transferButton" styleClass="account-action-button" stylesheets="@../styles.css" text="Transfer" />
    <Button fx:id="cancelButton" stylesheets="@../styles.css" text="Back">
      <styleClass>
         <String fx:value="cancel-button" />
         <String fx:value="account-action-button" />
      </styleClass></Button>
    <Button fx:id="deleteButton" text="delete" />
   <Button fx:id="freezeButton" layoutX="100.0" layoutY="208.0" text="freeze" />
</VBox>
